[
  {"ten":"EDATE","cu_phap_chuan":"=EDATE(start_date, months)","giai_thich":"Cộng/trừ N tháng giữ nguyên ngày. CFI: EDATE(\"2026-01-31\",3) → 2026-04-30.","vi_du_web":"=EDATE(\"2026-01-31\", 3) → 2026-04-30","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"EOMONTH","cu_phap_chuan":"=EOMONTH(start_date, months)","giai_thich":"Trả về ngày cuối tháng sau khi cộng N tháng; months=0 là tháng hiện tại.","vi_du_web":"=EOMONTH(\"2026-07-18\", 0) → 2026-07-31","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"DATE","cu_phap_chuan":"=DATE(year, month, day)","giai_thich":"Tạo số serial ngày từ năm/tháng/ngày; dùng khi hàm khác cần đối số ngày.","vi_du_web":"=DATE(2026,4,1)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"TODAY","cu_phap_chuan":"=TODAY()","giai_thich":"Chèn/hiển thị ngày hôm nay, không đối số; tự cập nhật mỗi ngày.","vi_du_web":"=TODAY()","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"NETWORKDAYS","cu_phap_chuan":"=NETWORKDAYS(start_date, end_date, [holidays])","giai_thich":"Đếm số ngày làm việc giữa 2 mốc (mặc định nghỉ T7+CN), trừ lễ.","vi_du_web":"=NETWORKDAYS(\"2026-04-01\",\"2026-04-30\")","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"YEAR","cu_phap_chuan":"=YEAR(serial_number)","giai_thich":"Tách năm từ một ngày; kết hợp TODAY để tính tuổi/thâm niên.","vi_du_web":"=YEAR(\"2026-07-18\") → 2026","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"YEARFRAC","cu_phap_chuan":"=YEARFRAC(start_date, end_date, [basis])","giai_thich":"Hàm MỚI (video không dạy): phần lẻ năm giữa 2 ngày, dùng tính lãi/phân bổ.","vi_du_web":"=YEARFRAC(\"2026-01-01\",\"2026-03-31\") → 0.25","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"INDEX","cu_phap_chuan":"=INDEX(array, row_num, [col_num])","giai_thich":"Lấy giá trị tại hàng/cột thứ N trong vùng; dò dọc + ngang.","vi_du_web":"=INDEX(C2:C100, 5)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"MATCH","cu_phap_chuan":"=MATCH(lookup_value, lookup_array, [match_type])","giai_thich":"Trả về vị trí của giá trị trong dãy 1 chiều; match_type 0 = chính xác.","vi_du_web":"=MATCH(A2, A2:A100, 0)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"INDEX/MATCH","cu_phap_chuan":"=INDEX(return_range, MATCH(lookup_value, lookup_array, 0))","giai_thich":"Cặp dò linh hoạt mạnh hơn VLOOKUP: lấy được cột TRÁI cột dò, 2 chiều.","vi_du_web":"=INDEX(C2:C100, MATCH(A2, A2:A100, 0))","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"VLOOKUP","cu_phap_chuan":"=VLOOKUP(lookup_value, table_array, col_index_num, [range_lookup])","giai_thich":"Dò dọc trong bảng; FALSE/0 = chính xác. MS khuyên thử XLOOKUP mới.","vi_du_web":"=VLOOKUP(A2, A2:D100, 3, FALSE)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"HLOOKUP","cu_phap_chuan":"=HLOOKUP(lookup_value, table_array, row_index_num, [range_lookup])","giai_thich":"Dò ngang trong bảng (ngược với VLOOKUP).","vi_du_web":"=HLOOKUP(A2, A1:Z10, 3, FALSE)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"OFFSET","cu_phap_chuan":"=OFFSET(reference, rows, cols, [height], [width])","giai_thich":"Hàm MỚI theo nghĩa lookup CFI (video chỉ dùng OFFSET làm dropdown động): dịch tham chiếu N hàng/cột.","vi_du_web":"=OFFSET(A2, 1, 2)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"XLOOKUP","cu_phap_chuan":"=XLOOKUP(lookup_value, lookup_array, return_array, [if_not_found])","giai_thich":"Hàm MỚI (video không dạy): thay VLOOKUP/HLOOKUP, dò trái/phải, khớp chính xác mặc định.","vi_du_web":"=XLOOKUP(A2, A2:A100, C2:C100, \"Not found\")","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"SUM","cu_phap_chuan":"=SUM(number1, [number2], ...)","giai_thich":"Cộng tổng dãy số; MS ví dụ =SUM(B1:B10).","vi_du_web":"=SUM(B2:B100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"AVERAGE","cu_phap_chuan":"=AVERAGE(number1, ...)","giai_thich":"Trung bình cộng dãy số.","vi_du_web":"=AVERAGE(B2:B100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"MEDIAN","cu_phap_chuan":"=MEDIAN(number1, ...)","giai_thich":"Hàm MỚI (video không dạy): trung vị dãy số.","vi_du_web":"=MEDIAN(B2:B100)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"SUMPRODUCT","cu_phap_chuan":"=SUMPRODUCT(array1, [array2], ...)","giai_thich":"Nhân từng cặp rồi cộng tổng; CFI dùng tính bình quân gia quyền.","vi_du_web":"=SUMPRODUCT(B2:B100, C2:C100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PRODUCT","cu_phap_chuan":"=PRODUCT(number1, ...)","giai_thich":"Hàm MỚI: nhân tất cả các số trong dãy.","vi_du_web":"=PRODUCT(B2:B5)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"ROUNDDOWN","cu_phap_chuan":"=ROUNDDOWN(number, num_digits)","giai_thich":"Hàm MỚI: làm tròn xuống N chữ số.","vi_du_web":"=ROUNDDOWN(B2,2)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"ROUNDUP","cu_phap_chuan":"=ROUNDUP(number, num_digits)","giai_thich":"Hàm MỚI: làm tròn lên N chữ số.","vi_du_web":"=ROUNDUP(B2,2)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"ABS","cu_phap_chuan":"=ABS(number)","giai_thich":"Hàm MỚI: giá trị tuyệt đối.","vi_du_web":"=ABS(-5) → 5","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PI","cu_phap_chuan":"=PI()","giai_thich":"Hàm MỚI: hằng số pi chính xác 15 chữ số.","vi_du_web":"=PI()","trung_lap_voi_video":false,"nguon":"https://support.microsoft.com/vi-vn/excel/get-started/overview-of-formulas-in-excel"},
  {"ten":"SUMIF","cu_phap_chuan":"=SUMIF(range, criteria, [sum_range])","giai_thich":"Cộng theo 1 điều kiện.","vi_du_web":"=SUMIF(A2:A100, \"North\", B2:B100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"SUMQ (SUMSQ)","cu_phap_chuan":"=SUMSQ(number1, ...)","giai_thich":"Hàm MỚI: tổng bình phương các đối số (web ghi SUMQ).","vi_du_web":"=SUMSQ(B2:B5)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"COUNT","cu_phap_chuan":"=COUNT(value1, ...)","giai_thich":"Đếm ô chứa số.","vi_du_web":"=COUNT(B2:B100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"COUNTA","cu_phap_chuan":"=COUNTA(value1, ...)","giai_thich":"Đếm ô không rỗng.","vi_du_web":"=COUNTA(A2:A100)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"COUNTIF","cu_phap_chuan":"=COUNTIF(range, criteria)","giai_thich":"Đếm theo 1 điều kiện.","vi_du_web":"=COUNTIF(B2:B100,\">100\")","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"COUNTIFS","cu_phap_chuan":"=COUNTIFS(criteria_range1, criteria1, ...)","giai_thich":"Đếm theo nhiều điều kiện (AND).","vi_du_web":"=COUNTIFS(A2:A100,\"North\",B2:B100,\">100\")","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"NPV","cu_phap_chuan":"=NPV(rate, value1, [value2], ...)","giai_thich":"Hàm TÀI CHÍNH MỚI (video không dạy): giá trị hiện tại ròng theo lãi suất chiết khấu.","vi_du_web":"=NPV(0.1,B2:B6)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"XNPV","cu_phap_chuan":"=XNPV(rate, values, dates)","giai_thich":"Hàm TÀI CHÍNH MỚI: NPV theo ngày cụ thể.","vi_du_web":"=XNPV(0.1,B2:B6,A2:A6)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"IRR","cu_phap_chuan":"=IRR(values, [guess])","giai_thich":"Hàm TÀI CHÍNH MỚI: suất sinh lời nội bộ (lãi suất để NPV=0).","vi_du_web":"=IRR(B2:B6)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"XIRR","cu_phap_chuan":"=XIRR(values, dates, [guess])","giai_thich":"Hàm TÀI CHÍNH MỚI: IRR theo ngày cụ thể.","vi_du_web":"=XIRR(B2:B8,A2:A8)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"YIELD","cu_phap_chuan":"=YIELD(settlement, maturity, rate, pr, redemption, frequency, [basis])","giai_thich":"Hàm TÀI CHÍNH MỚI: lợi suất chứng khoán theo đáo hạn/mệnh giá/lãi suất.","vi_du_web":"=YIELD(A2,B2,0.05,95,100,2,0)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"FV","cu_phap_chuan":"=FV(rate, nper, pmt, [pv], [type])","giai_thich":"Hàm TÀI CHÍNH MỚI: giá trị tương lai với góp đều + lãi cố định.","vi_du_web":"=FV(0.05/12,60,-200,0,0)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PV","cu_phap_chuan":"=PV(rate, nper, pmt, [fv], [type])","giai_thich":"Hàm TÀI CHÍNH MỚI: giá trị hiện tại của khoản đầu tư.","vi_du_web":"=PV(0.05/12,60,-200,0,0)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"IPMT","cu_phap_chuan":"=IPMT(rate, per, nper, pv, [fv], [type])","giai_thich":"Hàm TÀI CHÍNH MỚI: phần lãi của kỳ trả nợ.","vi_du_web":"=IPMT(0.05/12,1,60,-10000)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PMT","cu_phap_chuan":"=PMT(rate, nper, pv, [fv], [type])","giai_thich":"Hàm TÀI CHÍNH MỚI: tổng tiền trả (gốc+lãi) mỗi kỳ.","vi_du_web":"=PMT(0.05/12,60,-10000)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PRICE","cu_phap_chuan":"=PRICE(settlement, maturity, rate, yld, redemption, frequency, [basis])","giai_thich":"Hàm TÀI CHÍNH MỚI: giá/100 mệnh giá trái phiếu coupon định kỳ.","vi_du_web":"=PRICE(A2,B2,0.05,0.045,100,2,0)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"DB","cu_phap_chuan":"=DB(cost, salvage, life, period, [month])","giai_thich":"Hàm TÀI CHÍNH MỚI: khấu hao theo số dư giảm dần cố định.","vi_du_web":"=DB(10000,1000,5,1)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"DDB","cu_phap_chuan":"=DDB(cost, salvage, life, period, [factor])","giai_thich":"Hàm TÀI CHÍNH MỚI: khấu hao theo số dư giảm dần kép.","vi_du_web":"=DDB(10000,1000,5,1)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"SLN","cu_phap_chuan":"=SLN(cost, salvage, life)","giai_thich":"Hàm TÀI CHÍNH MỚI: khấu hao đường thẳng.","vi_du_web":"=SLN(10000,1000,5)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"PPMT","cu_phap_chuan":"=PPMT(rate, per, nper, pv, [fv], [type])","giai_thich":"Hàm TÀI CHÍNH MỚI: phần gốc của kỳ trả nợ.","vi_du_web":"=PPMT(0.05/12,1,60,-10000)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"INTRATE","cu_phap_chuan":"=INTRATE(settlement, maturity, investment, redemption, [basis])","giai_thich":"Hàm TÀI CHÍNH MỚI: lãi suất chứng khoán đầu tư toàn bộ.","vi_du_web":"=INTRATE(A2,B2,950,1000,0)","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"IF","cu_phap_chuan":"=IF(logical_test, value_if_true, value_if_false)","giai_thich":"Kiểm tra điều kiện, đúng trả tham số 2, sai trả tham số 3.","vi_du_web":"=IF(A1>0,\"tot\",\"xau\") — web VN: =IF(A1>0, \"tốt\", \"xấu\")","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"OR","cu_phap_chuan":"=OR(logical1, [logical2], ...)","giai_thich":"Đúng khi ÍT NHẤT 1 điều kiện đúng.","vi_du_web":"=OR(E2=\"Tốt\", E2=\"Trung bình\")","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"XOR","cu_phap_chuan":"=XOR(logical1, [logical2], ...)","giai_thich":"Hàm MỚI: exclusive-or, TRUE khi số mệnh đề TRUE là lẻ.","vi_du_web":"=XOR(TRUE,FALSE) → TRUE","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"AND","cu_phap_chuan":"=AND(logical1, [logical2], ...)","giai_thich":"Đúng chỉ khi TẤT CẢ đúng.","vi_du_web":"=AND(E2=\"Tốt\", F2>=7)","trung_lap_voi_video":true,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"NOT","cu_phap_chuan":"=NOT(logical)","giai_thich":"Hàm MỚI: đảo TRUE↔FALSE.","vi_du_web":"=NOT(TRUE) → FALSE","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"IFERROR","cu_phap_chuan":"=IFERROR(value, value_if_error)","giai_thich":"Hàm MỚI: nếu ô lỗi thì hiển thị kết quả thay thế.","vi_du_web":"=IFERROR(VLOOKUP(...),\"Không tìm thấy\")","trung_lap_voi_video":false,"nguon":"https://corporatefinanceinstitute.com/resources/excel/excel-formulas-cheat-sheet/"},
  {"ten":"IF lồng nhau (Nested IF)","cu_phap_chuan":"=IF(test1, v1, IF(test2, v2, v3))","giai_thich":"Lồng IF trong nhánh FALSE để xếp loại nhiều mức; tối đa 64 hàm (cũ 7).","vi_du_web":"=ROUND(SUM(B2:B6),0); =IF(F2<5,\"Kém\",IF(F2<7,\"Trung bình\",\"Khá\"))","trung_lap_voi_video":true,"nguon":"https://blog.hocexcel.online/cong-thuc-trong-excel-vi-du-va-meo-de-tiet-kiem-thoi-gian.html"},
  {"ten":"Toán tử & (nối văn bản)","cu_phap_chuan":"=A1 & \" \" & B1","giai_thich":"Toán tử nối chuỗi (&); tương đương CONCATENATE.","vi_du_web":"=A1 & \" \" & B1 (mã quốc gia + số điện thoại)","trung_lap_voi_video":true,"nguon":"https://blog.hocexcel.online/cong-thuc-trong-excel-vi-du-va-meo-de-tiet-kiem-thoi-gian.html"},
  {"ten":"Toán tử : (phạm vi)","cu_phap_chuan":"A1:A100, A:A, 1:1","giai_thich":"Toán tử phạm vi: tạo tham chiếu nhiều ô giữa 2 ô; cả cột (A:A) / cả hàng (1:1).","vi_du_web":"=AVERAGE(A1:A100); =SUM(A:A)","trung_lap_voi_video":true,"nguon":"https://blog.hocexcel.online/cong-thuc-trong-excel-vi-du-va-meo-de-tiet-kiem-thoi-gian.html"},
  {"ten":"Toán tử giao (khoảng trắng)","cu_phap_chuan":"=B3:D3 C2:C4","giai_thich":"Hàm MỚI: toán tử giao lấy ô chung của 2 tham chiếu.","vi_du_web":"=B3:D3 C2:C4","trung_lap_voi_video":false,"nguon":"https://blog.hocexcel.online/cong-thuc-trong-excel-vi-du-va-meo-de-tiet-kiem-thoi-gian.html"},
  {"ten":"Tham chiếu $A$1 (tuyệt đối)","cu_phap_chuan":"$A$1 (tuyệt đối); A1 (tương đối); $A1 / A$1 (hỗn hợp)","giai_thich":"$ khóa cột/dòng khi copy công thức; MS: =$A$1 giữ nguyên khi fill B2→B3.","vi_du_web":"=$A$1 giữ nguyên; =A1 đổi thành =A2 khi fill","trung_lap_voi_video":true,"nguon":"https://support.microsoft.com/vi-vn/excel/get-started/overview-of-formulas-in-excel"},
